# Shared
TRANSFER_DROP_DIR=./dropbox_in
OUTPUT_DIR=./output

# Hugging Face token required for pyannote.audio speaker diarization and personal voice detection
HF_TOKEN=your_huggingface_token_here

# Processing machine defaults
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Local LLM Extraction Config
USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3

# Optional LLM provider (future wiring)
LLM_PROVIDER=stub
LLM_API_KEY=
